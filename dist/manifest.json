{
  "manifest_version": 3,
  "name": "Orbit AI \u2014 Your Provider, Your Workspace",
  "version": "3.3.0",
  "minimum_chrome_version": "116",
  "description": "Provider-agnostic browser copilot with persistent BYOP setup, smart context, screenshots, supervised page automation and site navigation.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Orbit AI",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open Orbit"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; img-src 'self' data:; connect-src https: http://localhost:* http://127.0.0.1:*;"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
