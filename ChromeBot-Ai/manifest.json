{
  "manifest_version": 3,
  "name": "ChromeBot Ai",
  "version": "4.3.0",
  "description": "Super-agent crew for Chrome: multi-tab control, approvals, skills, memory, schedules, screenshots and data export. Cline login, NVIDIA NIM, Gemini, OpenAI, Groq, OpenRouter, custom OpenAI-compatible with model fetch + quality + custom headers.",
  "minimum_chrome_version": "124",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus",
    "webNavigation",
    "clipboardWrite",
    "downloads",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ChromeBot Ai",
    "default_icon": {
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "page.js",
        "widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
